# ===============================
# Node.js / npm / yarn
# ===============================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ===============================
# Build outputs
# ===============================
dist/
build/
.vite/
*.tsbuildinfo

# ===============================
# Environment files (sensitive)
# ===============================
.env
.env.local
.env.development
.env.production
.env.test

# ===============================
# Logs
# ===============================
logs/
*.log
*.log.*

# ===============================
